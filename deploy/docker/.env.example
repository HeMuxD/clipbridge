# 复制为 .env 后填写，docker compose 会自动读取同目录下的 .env
#
#   cp .env.example .env

# 生成方式：openssl rand -hex 32
# 必须设置且必须长期保持不变，否则容器每次重建后所有设备都要重新配对。
CLIPBRIDGE_JWT_SECRET=

# 对外访问基地址，用于拼接图片下载 URL。必须改成实际能访问到的地址。
#   走域名 + TLS → https://clip.example.com
#   局域网直连    → http://192.168.1.10:8080
CLIPBRIDGE_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 端口绑定的网卡地址。
#   前置宿主机 Nginx  → 保持 127.0.0.1，只对本机开放
#   无 Nginx 直接访问  → 改成 0.0.0.0（注意此时是明文 HTTP，
#                       Android 9+ 会直接拒绝，只适合 Windows 端或内网调试）
CLIPBRIDGE_BIND=127.0.0.1
