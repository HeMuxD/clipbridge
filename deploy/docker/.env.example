# 复制为 .env 后填写，docker compose 会自动读取同目录下的 .env
#
#   cp .env.example .env

# ---------- 必填 ----------

# 对外域名（只影响 nginx 的 server_name；用 _ 表示不校验 Host）
CLIPBRIDGE_SERVER_NAME=nas.example.com

# 必须与下面的端口一致，且必须带上端口号 —— 它用于拼接图片下载 URL，
# 少一个端口号客户端就会拿到打不开的地址。
CLIPBRIDGE_PUBLIC_BASE_URL=https://nas.example.com:8443

# 生成方式：openssl rand -hex 32
# 必须设置且长期保持不变，否则容器每次重建后所有设备都要重新配对。
CLIPBRIDGE_JWT_SECRET=

# 固定配对码（可选，8 位数字）。
# 填了就【永久有效】且可被多台设备重复使用 —— 手机、平板、笔记本都能用同一个码配，
# 不必每次去容器日志里翻，也不必为了加一台设备重启服务端。
# 留空则启动时随机生成一个 8 位码，有效期由 config.yaml 的 auth.pair_code_ttl 决定。
#
# 安全提示：固定码一旦泄露就长期有效，所以只在必要时用，怀疑泄露就换一个。
# 服务端已对 /api/pair 做按来源 IP 的限流（10 次/分钟；8 位码穷举一遍要约 19 年），
# 这是"码可以长期有效"的前提，别去动它。
CLIPBRIDGE_PAIR_CODE=

# ---------- 端口 ----------

# 家庭宽带 80/443 被运营商封锁，所以用 8443。
# 这个值同时决定容器内 nginx 的监听端口和宿主机映射端口，改一处即可。
CLIPBRIDGE_HTTPS_PORT=8443

# 明文 HTTP，仅用于局域网调试（Android 9+ 会拒绝明文，只能先用电脑端调通）。
# 不想暴露就把 compose 里对应的 ports 那一行注释掉。
CLIPBRIDGE_HTTP_PORT=8080

# ---------- 证书 ----------
#
# 两种模式，二选一。默认是 A，什么都不用改。
#
# ┌─ A) 宿主机签发，容器只读挂载（默认）
# │  acme.sh 装在宿主机上（或别处），签好后把证书装进下面的 CLIPBRIDGE_CERT_DIR：
# │
# │    acme.sh --install-cert -d nas.example.com --ecc \
# │      --fullchain-file <目录>/fullchain.pem \
# │      --key-file       <目录>/privkey.pem \
# │      --reloadcmd      "docker exec clipbridge nginx -s reload"
# │
# │  ⚠️ reloadcmd 用 nginx -s reload 而不是 docker restart：
# │     证书目录是按【目录】挂载的，新文件立刻可见，热加载不会断开现有连接。
# │     每次续期都重启容器会让手机端断连几秒，没必要。
# │
# │  目录里没有证书时不会崩，容器会降级为"仅明文 HTTP"并打印提示。
# │
# └─ B) 容器内自动签发与续期（**设置 CLIPBRIDGE_ACME_DOMAIN 即启用**）
#    容器自己下载 acme.sh、用 DNS-01 签发、装进数据卷，并每 12 小时检查一次续期。
#    好处：宿主机上不需要任何东西，也不需要 sudo 去拷证书；
#          因为证书直接在容器里，续期走热加载，全程不断连。
#    代价：DNS API 凭据要能进容器。
#
#    只改这一行就启用：
# CLIPBRIDGE_ACME_DOMAIN=nas.example.com
#
#    然后提供对应服务商的凭据（默认用 Cloudflare 的 dns_cf 钩子）：
#
#    ⚠️ 这个 Token 等价于"能改你域名解析"的权限，**绝对不要提交到版本库**。
#       deploy/docker/.env 已在 .gitignore 里；推送到 GitHub 前顺手 grep 一下
#       CF_Token 确认没有泄漏。
#
#    权限只要 Zone → DNS → Edit，Zone Resources 限定到你的域名即可，别用 Global API Key。
CLIPBRIDGE_ACME_EMAIL=you@example.com
CF_Token=
#
#    想避免 Token 出现在 `docker inspect` 里，改用文件方式（二选一即可）：
#      1) cp acme-credentials.example acme-credentials && vi acme-credentials
#      2) 在 docker-compose.yml 的 volumes 里取消注释这两行：
#           - ./acme-credentials:/acme-credentials:ro
#      3) 把上面的 CF_Token= 清空
#
#    其它服务商：把 CLIPBRIDGE_ACME_DNS 换成对应的钩子名（如 dns_ali、dns_dp），
#    并提供该钩子需要的环境变量。钩子清单见 acme.sh 的 dnsapi 目录。
# CLIPBRIDGE_ACME_DNS=dns_cf
#
#    调试时强烈建议先设成 1 —— 走 Let's Encrypt 测试环境，不消耗生产配额。
#    （同一个域名在生产环境每周只能签发 5 次，连试几次就会被锁住。）
#    签出来的证书浏览器不认，只是用来验证流程能不能走通，验证完改回 0。
# CLIPBRIDGE_ACME_STAGING=0
#
#    强制走 IPv4（默认 1）。别轻易关掉：Docker 默认 bridge 没有 IPv6 出口，
#    容器解析到 AAAA 后会先试 IPv6，然后连接挂到超时；而 acme.sh 对 POST
#    请求不设响应超时，一次丢包就永久卡死（本项目实测：finalize 挂着不动，
#    强制 IPv4 后连续 5 次全部成功）。
#    只有在你的环境 IPv6 明显更稳时才设成 0。
# CLIPBRIDGE_ACME_IPV4_ONLY=1

# 存放 fullchain.pem 与 privkey.pem 的宿主机目录（模式 A 用；模式 B 忽略它）
CLIPBRIDGE_CERT_DIR=./certs

# 证书在容器【内】的路径（一般不用改）。
# 模式 A 默认 /certs/fullchain.pem；模式 B 自动切到 /var/lib/clipbridge/certs/ 下。
# CLIPBRIDGE_CERT_FILE=
# CLIPBRIDGE_KEY_FILE=

# ---------- 同步行为 ----------

# 离线补推窗口（秒）。0 = 不补推（默认）：
# 只同步"当前这一次"复制/截图，设备离线期间攒下的旧内容一律丢弃。
# 想容忍几秒网络抖动（重连空档里的内容不丢），改成 60~120。
CLIPBRIDGE_OFFLINE_REPLAY_SECONDS=0
