<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClipBridge</AssemblyName>
    <RootNamespace>ClipBridge</RootNamespace>
    <Version>0.0.8</Version>

    <!-- 应用图标：资源管理器 / 任务栏 / 快捷方式上显示的图标。
         由 clients/windows/make_app_icon.py 生成（可重复执行），
         图案与运行时绘制的托盘图标一致。 -->
    <ApplicationIcon>..\assets\clipbridge.ico</ApplicationIcon>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 单文件发布，避免用户装 .NET 运行时 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 裁剪会误删 WinForms 与反射用到的类型，这里关闭 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- 不能用 InvariantGlobalization：WinForms 在文本框获得焦点 / 处理输入法时
         会按 LCID 去取 CultureInfo，invariant 模式下直接抛 CultureNotFoundException
         （实测：1033 (0x0409) is an invalid culture identifier），表现为 UI 线程异常。
         Windows 10 1903+ 自带 icu.dll，关掉它不会让自包含产物缺文件。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- 系统剪贴板读写依赖 WinForms 的 Clipboard 类与 Win32 互操作 -->
  <ItemGroup>
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
