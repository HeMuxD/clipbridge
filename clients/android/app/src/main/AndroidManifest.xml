<?xml version="1.0" encoding="utf-8"?>
<!--
  ClipBridge Android 客户端清单。

  数据流：
    · 上行（本机复制 → 电脑）：无障碍服务感知复制动作，见 ClipboardAccessibilityService
    · 下行（电脑复制/截图 → 本机）：直接把内容写进系统剪贴板，全程无通知、无操作
    · 兜底上行：系统分享菜单（ACTION_SEND），零权限，100% 可靠

  注意：Android 10+ 后台应用无法读取剪贴板，且没有任何权限可以申请。
  无障碍服务是唯一免 Root 的自动上行方案 —— 详见 docs/可行性报告.md 第 3.2 节。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 网络 ========== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ========== 可选的前台服务保活 ==========
         默认不使用后台常驻通知；只有用户主动打开「常驻通知保活」时才会启动。
         Android 14+ 要求声明具体类型，否则 startForeground 抛 SecurityException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 只有开启保活时才需要（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ClipBridgeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipBridge"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- ========== 主界面（配对 + 状态 + 无障碍引导） ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 无障碍服务：无感同步的核心 ==========
             它同时承担两件事：
               1. 感知用户复制了什么（上行）
               2. 作为同步长连接的保活载体 —— 因此不需要前台服务，也就没有任何常驻通知
             ⚠️ 厂商 ROM 差异大：部分系统会定时关闭无障碍服务，
                所以 App 内必须做「是否仍在运行」的定期自检（MainActivity 里已实现）。 -->
        <service
            android:name=".service.ClipboardAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ========== 可选的前台服务保活 ==========
             默认不启动。部分国产 ROM 会掐掉没有前台身份的后台进程，
             用户可在设置里打开，代价是通知栏里会多一条静默通知。 -->
        <service
            android:name=".service.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ========== 分享菜单接收：兜底上行入口（零权限） ========== -->
        <activity
            android:name=".receiver.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ClipBridge.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- ========== FileProvider ==========
             仅用于 Android 9 及以下：把收到的图片暴露成 content:// URI 以便写进剪贴板。
             Android 10+ 走 MediaStore，不需要它。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
