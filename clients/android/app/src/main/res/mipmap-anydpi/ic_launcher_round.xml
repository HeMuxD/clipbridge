                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="104"
                android:endY="104">
                <item android:offset="0" android:color="#FF5AA0E8" />
                <item android:offset="1" android:color="#FF2B6CBC" />
            </gradient>
        </aapt:attr>
    </path>

