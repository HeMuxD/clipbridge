<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ClipBridge</string>

    <!-- 无障碍服务文案：必须如实说明用途，否则用户会疑虑，也可能被系统标记为可疑 -->
    <string name="accessibility_service_label">ClipBridge 无感同步</string>
    <string name="accessibility_service_summary">在后台感知你的复制操作并自动同步</string>
    <string name="accessibility_service_description">
        Android 10 起，应用在后台无法读取剪贴板内容 —— 这是系统为保护隐私所做的限制，且没有任何权限可以申请绕过。\n\nClipBridge 需要此服务才能在后台感知你的复制操作，并自动同步到你的电脑。\n\n本服务只接收「文本选中」与「点击复制/剪切」这几类无障碍事件：不读取屏幕内容、不模拟点击、不采集任何个人信息。所有数据只发送到你自己配置的服务器。
    </string>

    <string name="share_target_label">同步到 ClipBridge</string>

    <!-- 可选保活通知：默认不出现，只有用户打开「常驻通知保活」才显示。
         通知上没有任何操作按钮 —— 同步是全自动的。 -->
    <string name="channel_sync_name">同步保活</string>
    <string name="channel_sync_desc">保持与服务端的连接</string>
    <string name="notif_sync_title">ClipBridge 后台同步中</string>
    <string name="notif_sync_desc">保持连接以便实时收发内容</string>
</resources>
